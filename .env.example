# Copy to .env and fill real values. Never commit .env.

# Local: docker compose up -d postgres
DATABASE_URL="postgresql://ham_masir:ham_masir@localhost:5432/ham_masir"
# Dummy is enough for next dev. Real token is only required on the VPS.
TELEGRAM_BOT_TOKEN="local-dev-telegram-token"
TELEGRAM_BOT_USERNAME="HamMasirClubBot"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="HamMasirClubBot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Telegram Login Widget → OpenID Connect (BotFather / Web Login)
TELEGRAM_OIDC_CLIENT_ID="1234567890"
TELEGRAM_OIDC_CLIENT_SECRET="replace-with-telegram-oidc-client-secret"
# Register these exact URLs in BotFather Web Login:
#   {NEXT_PUBLIC_APP_URL}
#   {NEXT_PUBLIC_APP_URL}/api/auth/telegram-oidc/callback
NODE_ENV="development"

# Local-only auth bypass (ignored unless NODE_ENV=development AND ALLOW_DEV_AUTH=true)
ALLOW_DEV_AUTH="true"
# Seed users: 1000000001 = admin, 1000000002 = regular member
DEV_TELEGRAM_ID="1000000001"

# Protects /api/cron/reminders (VPS cron sends Bearer CRON_SECRET)
CRON_SECRET="replace-with-a-long-random-secret"

# Private Telegram chat/channel where the bot stores uploaded media (file_id).
# For channels/supergroups use the -100... form (e.g. -1003962740691).
# The bot must be admin with permission to post photos.
TELEGRAM_STORAGE_CHAT_ID="-100xxxxxxxxxx"
