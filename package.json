{
  "name": "rooberah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:setup": "prisma migrate deploy && node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.16",
    "@telegram-apps/sdk-react": "^2.0.21",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
